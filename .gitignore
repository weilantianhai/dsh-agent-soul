# ─────────────────────────────── 依赖
node_modules/

# ─────────────────────────────── 测试 / 调试产物
.tmp-*/
.tmp-*
*.tmp
*.tgz
.coverage/
coverage/
.tmp-verify-memory

# ─────────────────────────────── 运行数据（永远不进仓库）
# 用户的人格、日记、日志、登记表。每个人的都不一样，进来就废了，
# 而且里面有私人对话。仓库只放代码，不放谁的记忆。
memory/
*.jsonl
sessions.json
daily.state.json
plugin-status.json
plugin-status.log

# ─────────────────────────────── 自动备份
# 改人格 / 登记表前自动生成的 *.bak-<时间戳>
*.bak-*
*.bak
.backup-*

# ─────────────────────────────── 只给自己看的东西，不是开发者文档
# 这里放"本次改了什么、下一步干嘛"这类工作记录。
# 别人拉仓库要的是 docs/ 下的架构和约定，不是我们的日志 ——
# 混进来会让人以为那是项目的一部分。
.private/

# ─────────────────────────────── 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/
.git-backup-*
.rewrite.sh
